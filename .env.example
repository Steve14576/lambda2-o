# Lambda² 环境变量配置
# 复制为 .env 并填入实际值

# ===== LLM =====
LLM_PROVIDER=openai              # openai / dashscope / volcengine
LLM_MODEL=qwen-max               # 模型名
LLM_API_KEY=sk-xxx               # API Key
LLM_BASE_URL=                    # 自定义 endpoint (可选)

# ===== TTS 远程服务器 =====
TTS_REMOTE_URL=ws://192.168.1.100:9100/tts/stream
TTS_REMOTE_TIMEOUT_MS=5000

# ===== 音频设备 =====
INPUT_DEVICE_ID=                  # sounddevice 设备 ID (留空=系统默认)
OUTPUT_DEVICE_ID=                 # sounddevice 设备 ID (留空=系统默认)

# ===== 角色配置路径 =====
CHARACTERS_DIR=configs/characters

# ===== 调试 =====
LOG_LEVEL=INFO                    # DEBUG / INFO / WARNING / ERROR
DEV_MODE=false                    # true = 跳过硬件检查,用 mock 音频
DEMO_MODE=false                   # true = 无角色数据时使用内置 demo
